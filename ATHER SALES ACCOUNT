function paymentsCSV(){
 const head=['Date','Customer Name','Mobile','Frame No','Invoice No','Payment Mode','Reference No','Amount','Note'];
 const rows=[head];let any=false;
 state.customers.forEach(c=>(c.payments||[]).forEach(p=>{any=true;rows.push([dstr(p.date),c.name,c.mobile,c.frameNo,c.invoiceNo,p.mode,p.ref,num(p.amount),p.note])}));
 if(!any){toast('Koi payment nahi hai');return}
 dl('payment-ledger-'+todayISO()+'.csv',csv(rows));toast('Payment ledger download ho gaya ✔');
}
function backupJSON(){dl('account-book-backup-'+todayISO()+'.json',JSON.stringify(state,null,1),'application/json');toast('Backup download ho gaya ✔')}
function restoreJSON(ev){
 const file=ev.target.files[0];if(!file)return;
 const rd=new FileReader();
 rd.onload=()=>{try{const st=JSON.parse(rd.result);
   if(!st||!Array.isArray(st.customers))throw 0;
   if(!confirm('Restore karne se CURRENT data backup se replace ho jayega. Continue?'))return;
   state=st;saveNow().finally(()=>{go('dashboard');toast('Data restore ho gaya ✔')});}
  catch(e){alert('⚠️ Ye file valid backup nahi hai!')}};
 rd.readAsText(file);
}
