function dl(name,text,mime){const a=document.createElement('a');a.href=URL.createObjectURL(new Blob(['﻿'+text],{type:mime||'text/csv;charset=utf-8'}));a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),3000)}
function csvCell(x){return '"'+String(x==null?'':x).replace(/"/g,'""')+'"'}
function csv(rows){return rows.map(r=>r.map(csvCell).join(',')).join('\r\n')}
function registerCSV(){
 if(!state.customers.length){toast('Data khali hai');return}
 const head=['Customer Name','Mobile','Model','Sale Date','Challan No','Invoice No','Frame No','Policy No','Financier',
  'Ex Showroom','PM EDrive Scheme','Price Reduction','Scheme Discount','Effective Ex Showroom','RTO','Insurance','Accessories','Accessories Kit 2','EBW','ECW','Pro Pack','Teflon Coating','RSA','HPN','Logistics','Other','Discount','Total Amount',
