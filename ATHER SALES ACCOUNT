 const amt=num($('#p_amt').value);const date=$('#p_date').value;
 if(!date){alert('⚠️ Date select karein');return}
 if(amt<=0){alert('⚠️ Amount 0 se zyada hona chahiye');return}
 c.payments.push({id:uid(),date:date,mode:$('#p_mode').value,amount:amt,ref:$('#p_ref').value.trim(),note:$('#p_note').value.trim()});
 save();toast(rupee(amt)+' ki payment entry ho gayi ✔');renderDetail($('#view'),cid);
