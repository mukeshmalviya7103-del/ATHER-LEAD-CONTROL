<script>
'use strict';
/* ================= STORAGE ENGINE (IndexedDB + localStorage mirror) =================
   Primary DB : IndexedDB "sab_db_v1" — separate, high-capacity, non-blocking database.
   Mirror     : localStorage "sab_state_v1" — instant-read safety copy, used only if
                IndexedDB is unavailable (very old browser / some private modes) or fails.
   Every existing save()/state call in this app is untouched — only the engine under it changed. */
const LS_KEY='sab_state_v1';
const IDB_NAME='sab_db_v1';
const IDB_STORE='kv';
const IDB_ROW='state';
const $=s=>document.querySelector(s);
const DEFAULT_MODELS=['TVS iQube','TVS iQube S','TVS Jupiter 125','TVS Jupiter 110','TVS NTorq 125','TVS Raider 125','TVS Apache RTR 160 2V','TVS Apache RTR 160 4V','TVS Apache RTR 200 4V','TVS Ronin','TVS Radeon','TVS Sport','TVS XL 100','TVS Zest 110','TVS Star City Plus'];
const DEFAULT_FINS=['TVS Credit','Bajaj Finserv','IDFC First Bank','HDFC Bank','Kotak Mahindra','Cholamandalam','Hero FinCorp','ICICI Bank','SBI','Poonawalla Fincorp','Muthoot Finance','Self / Cash'];
let state={customers:[]};
let _idb=null;          /* open IndexedDB handle, or null if unavailable */
let _idbOK=false;       /* true once we know IndexedDB is usable */
let _saveTimer=null;    /* debounce handle so rapid clicks don't spam writes */

function _emptyState(){return {customers:[]}}
function _parseState(raw){
 try{ if(!raw)return null; const st=JSON.parse(raw); if(!Array.isArray(st.customers))st.customers=[]; return st; }
 catch(e){ return null; }
}
function _lsRead(){ try{ return _parseState(localStorage.getItem(LS_KEY)); }catch(e){ return null; } }
function _lsWrite(){ try{ localStorage.setItem(LS_KEY,JSON.stringify(state)); return true; }catch(e){ return false; } }

function _idbOpen(){
 return new Promise(resolve=>{
  if(!('indexedDB' in window)){ resolve(null); return }
  let req;
  try{ req=indexedDB.open(IDB_NAME,1); }catch(e){ resolve(null); return }
  req.onupgradeneeded=()=>{ try{ req.result.createObjectStore(IDB_STORE); }catch(e){} };
  req.onsuccess=()=>resolve(req.result);
  req.onerror=()=>resolve(null);
  req.onblocked=()=>resolve(null);
 });
}
function _idbRead(db){
 return new Promise(resolve=>{
  try{
   const tx=db.transaction(IDB_STORE,'readonly');
   const rq=tx.objectStore(IDB_STORE).get(IDB_ROW);
   rq.onsuccess=()=>resolve(rq.result!=null?rq.result:null);
   rq.onerror=()=>resolve(null);
  }catch(e){ resolve(null); }
 });
}
function _idbWrite(db,data){
 return new Promise(resolve=>{
  try{
   const tx=db.transaction(IDB_STORE,'readwrite');
   tx.objectStore(IDB_STORE).put(data,IDB_ROW);
   tx.oncomplete=()=>resolve(true);
   tx.onerror=()=>resolve(false);
   tx.onabort=()=>resolve(false);
  }catch(e){ resolve(false); }
 });
}

/* save(): keeps the exact same name/signature every part of this app already calls.
   Writes to BOTH stores — IndexedDB (primary) and localStorage (fast mirror/fallback) —
   so a full account book is never resting in only one place. Debounced so fast repeated
   edits (typing, multiple clicks) collapse into one actual write shortly after the last one. */
function save(){
 _lsWrite();                       /* instant, synchronous mirror — cheap safety net */
 clearTimeout(_saveTimer);
 _saveTimer=setTimeout(()=>{
  if(_idbOK&&_idb){ const snapshot=JSON.parse(JSON.stringify(state)); _idbWrite(_idb,snapshot); }
 },120);
}
function saveNow(){ /* used before actions that leave the page (e.g. window.print) */
 _lsWrite();
 clearTimeout(_saveTimer);
 if(_idbOK&&_idb) return _idbWrite(_idb,JSON.parse(JSON.stringify(state)));
 return Promise.resolve(false);
}

function migrate(){
 let d=false;
 if(!state.masters)state.masters={};
 if(!Array.isArray(state.masters.models)){state.masters.models=DEFAULT_MODELS.slice();d=true}
 if(!Array.isArray(state.masters.financiers)){state.masters.financiers=DEFAULT_FINS.slice();d=true}
 if(!state.settings)state.settings={};
 const SD={firmName:'📒 Showroom Account Book',firmLine:'Customer Account & Payment Manager (Offline)',firmPhone:'',firmAddress:'',bankName:'',accountNo:'',ifsc:'',branch:'',upiId:'',themeColor:'#4f46e5',printHeadColor:'#312e81',printAccColor:'#e0e7ff',colorPrint:'yes',footerNote:''};
 Object.keys(SD).forEach(k=>{if(state.settings[k]==null){state.settings[k]=SD[k];d=true}});
 if(d)save();
}

/* Boot sequence: try IndexedDB first (separate, larger, non-blocking store).
   If it has data, use it. If it's empty but localStorage has older data, adopt that
   into IndexedDB (one-time upgrade path so nobody's existing data seems to vanish).
   If IndexedDB can't be opened at all, run on the localStorage mirror alone. */
async function _bootStorage(){
 const db=await _idbOpen();
 if(db){
  _idb=db; _idbOK=true;
  const loaded=await _idbRead(db);
  if(loaded&&typeof loaded==='object'&&Array.isArray(loaded.customers)){
   state=loaded;
  }else{
   const fromLs=_lsRead();
   state=fromLs||_emptyState();
   await _idbWrite(db,JSON.parse(JSON.stringify(state))); /* seed IndexedDB from the mirror/default so both stores agree */
  }
 }else{
  _idbOK=false;
  state=_lsRead()||_emptyState();
 }
 migrate();
}
function applyBrand(){const n=document.getElementById('brandName'),l=document.getElementById('brandLine');const S=state.settings||{};
 if(n)n.textContent=S.firmName||'📒 Showroom Account Book';if(l)l.textContent=S.firmLine||'Customer Account & Payment Manager (Offline)'}
function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,7)}
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
function num(v){const n=parseFloat(v);return isNaN(n)?0:n}
function rupee(n){n=num(n);const neg=n<0;return (neg?'- ':'')+'₹'+Math.abs(n).toLocaleString('en-IN',{maximumFractionDigits:2})}
function dstr(iso){if(!iso)return '—';const p=iso.split('-');return p.length===3?p[2]+'-'+p[1]+'-'+p[0]:iso}
function todayISO(){const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
function toast(m){const t=$('#toast');t.textContent=m;t.style.opacity=1;setTimeout(()=>t.style.opacity=0,2200)}

/* ================= CONFIG ================= */
const MODES=[
 ['Cash','Cash'],
 ['Card','Card'],
 ['Bank Cheque/DD','Bank Cheque / DD'],
 ['NEFT/RTGS','NEFT / RTGS'],
 ['Scan Pay/UPI','Scan Pay (UPI)'],
 ['Advance','Advance'],
 ['Finance','Finance (Loan Amt)'],
 ['Credit Note','Credit Note'],
 ['Short Payment','Short Payment / Write-off']
];
const FINSTATUS=['','Applied','Approved','Disbursed','Rejected','Closed'];
const BILL_FIELDS=[
 ['exShowroom','Ex Showroom'],
 ['pmEDrive','PM E-Drive Scheme  (–)'],
 ['priceReduction','Price Reduction  (–)'],
 ['schemeDiscount','Scheme Discount  (–)'],
 ['rto','RTO  (+)'],
 ['insurance','Insurance  (+)'],
 ['accessories','Accessories  (+)'],
 ['accessoriesKit2','Accessories Kit 2  (+)'],
 ['ebw','EBW  (+)'],
 ['ecw','ECW  (+)'],
 ['proPack','Pro Pack  (+)'],
 ['teflon','Teflon Coating  (+)'],
 ['rsa','RSA  (+)'],
 ['hpn','HPN  (+)'],
 ['logistics','Logistics  (+)'],
 ['other','Other  (+)'],
 ['discount','Discount  (–)']
];
function calcBill(b){b=b||{};const n=k=>num(b[k]);
 const eff=n('exShowroom')-n('pmEDrive')-n('priceReduction')-n('schemeDiscount');
 const adds=['rto','insurance','accessories','accessoriesKit2','ebw','ecw','proPack','teflon','rsa','hpn','logistics','other'].reduce((s,k)=>s+n(k),0);
 return {eff:eff,total:eff+adds-n('discount')};}
function calcPay(c){const mt={};MODES.forEach(m=>mt[m[0]]=0);let rec=0;
 (c.payments||[]).forEach(p=>{if(mt[p.mode]==null)mt[p.mode]=0;mt[p.mode]+=num(p.amount);rec+=num(p.amount)});
 return {mt:mt,rec:rec};}
function totals(c){const b=calcBill(c.billing);const p=calcPay(c);return {eff:b.eff,total:b.total,rec:p.rec,bal:b.total-p.rec,mt:p.mt}}
function statusOf(c){const t=totals(c);if(t.total<=0)return['b-due','—'];if(t.bal<0)return['b-adv','ADVANCE'];if(t.bal===0)return['b-paid','PAID'];if(t.rec>0)return['b-part','PARTIAL'];return['b-due','DUE']}
function findC(id){return state.customers.find(c=>c.id===id)}


/* ================= SETTINGS & THEME ================= */
const MCOLORS={'Cash':'#16a34a','Card':'#2563eb','Bank Cheque/DD':'#d97706','NEFT/RTGS':'#0d9488','Scan Pay/UPI':'#7c3aed','Advance':'#db2777','Finance':'#4f46e5','Credit Note':'#64748b','Short Payment':'#dc2626'};
function modeBadge(m){const col=MCOLORS[m]||'#334155';return `<span style="background:${col};color:#fff;padding:2px 9px;border-radius:999px;font-size:11px;font-weight:700;white-space:nowrap">${esc(m)}</span>`}
function colorChips(mt){return MODES.filter(m=>num(mt[m[0]])>0).map(m=>{const col=MCOLORS[m[0]]||'#334155';return `<span class="chip" style="background:${col};color:#fff;border-color:${col}">${m[1]}: <b>${rupee(mt[m[0]])}</b></span>`}).join('')}
function darken(h,f){h=(h||'#4f46e5').replace('#','');if(h.length!==6)return '#4f46e5';const n=v=>Math.max(0,Math.min(255,Math.round(v*f)));return '#'+[0,2,4].map(i=>n(parseInt(h.substr(i,2),16)).toString(16).padStart(2,'0')).join('')}
function applyTheme(){const S=state.settings||{};const c=S.themeColor||'#4f46e5';document.documentElement.style.setProperty('--pri',c);document.documentElement.style.setProperty('--pri2',darken(c,0.72))}
function resetTheme(){const S=state.settings;S.themeColor='#4f46e5';S.printHeadColor='#312e81';S.printAccColor='#e0e7ff';S.colorPrint='yes';save();applyTheme();renderSettings(document.getElementById('view'));toast('Colours default par aa gaye ✔')}
function renderSettings(v){
 const st=state.settings||{};
 v.innerHTML=`
 <div class="card">
  <div class="section-t">🏪 Showroom Details <span class="muted">(Heading + Print par dikhega)</span></div>
  <div class="grid g4">
   <div><label>Showroom / Firm Name (MAIN HEADING)</label><input id="s_firmName" value="${esc(st.firmName)}" placeholder="e.g. Shree Motors - TVS"></div>
   <div><label>Heading ke neeche wali line</label><input id="s_firmLine" value="${esc(st.firmLine)}"></div>
   <div><label>Showroom Phone</label><input id="s_firmPhone" value="${esc(st.firmPhone)}" placeholder="98XXXXXX10"></div>
   <div><label>Showroom Address (Print par)</label><input id="s_firmAddress" value="${esc(st.firmAddress)}"></div>
  </div>
 </div>
 <div class="card">
  <div class="section-t">🏦 Bank Details <span class="muted">(Print Statement par "Payment ke liye" box me dikhega)</span></div>
  <div class="grid g4">
   <div><label>Bank Name</label><input id="s_bankName" value="${esc(st.bankName)}" placeholder="e.g. State Bank of India"></div>
   <div><label>Account No</label><input id="s_accountNo" value="${esc(st.accountNo)}"></div>
   <div><label>IFSC Code</label><input id="s_ifsc" value="${esc(st.ifsc)}" placeholder="e.g. SBIN0001234"></div>
   <div><label>Branch</label><input id="s_branch" value="${esc(st.branch)}"></div>
   <div><label>UPI ID</label><input id="s_upiId" value="${esc(st.upiId)}" placeholder="e.g. shreemotors@okhdfc"></div>
  </div>
 </div>
 <div class="card">
  <div class="section-t">🎨 Colour &amp; Print Design <span class="muted">(App + Statement dono ka look)</span></div>
  <div class="grid g4">
   <div><label>App Theme Colour (header/buttons)</label><input id="s_themeColor" type="color" value="${st.themeColor||'#4f46e5'}" style="height:38px;padding:2px"></div>
   <div><label>Print Header Banner Colour</label><input id="s_printHeadColor" type="color" value="${st.printHeadColor||'#312e81'}" style="height:38px;padding:2px"></div>
   <div><label>Print Table Header Colour</label><input id="s_printAccColor" type="color" value="${st.printAccColor||'#e0e7ff'}" style="height:38px;padding:2px"></div>
   <div><label>Print Style</label><select id="s_colorPrint"><option value="yes" ${st.colorPrint!=='no'?'selected':''}>🌈 Colourful Print (recommended)</option><option value="no" ${st.colorPrint==='no'?'selected':''}>⚫ Simple Black &amp; White (ink bachao)</option></select></div>
   <div style="grid-column:span 2"><label>Print ke sabse neeche Note / Terms (optional)</label><input id="s_footerNote" value="${esc(st.footerNote)}" placeholder="e.g. Thank you! Visit again. | E&OE"></div>
  </div>
  <br>
  <div style="display:flex;gap:10px;flex-wrap:wrap">
   <button class="btn primary" onclick="saveSettings()">💾 Save Settings</button>
   <button class="btn ghost" onclick="resetTheme()">↩️ Colours Default par Lao</button>
  </div>
  <div class="muted" style="margin-top:8px">💡 🌈 Colourful print ke liye browser ke print dialog me <b>"Background graphics"</b> ON rakhein (Chrome me: More Settings → Background graphics ✔).</div>
 </div>`;
}

/* ================= GLOBAL SEARCH (header) ================= */
let _gsIndex=-1;
function globalSearchMatches(q){
 q=(q||'').trim().toLowerCase();
 if(!q)return [];
 return state.customers.filter(c=>[c.name,c.mobile,c.frameNo,c.invoiceNo,c.challanNo,c.model,c.ledgerName,c.policyNo]
  .join(' ').toLowerCase().includes(q)).slice(0,20);
}
function globalSearchInput(){
 const box=$('#globalSearchResults');
 const q=$('#globalSearch').value;
 _gsIndex=-1;
 if(!q.trim()){box.style.display='none';box.innerHTML='';return}
 const list=globalSearchMatches(q);
 if(!list.length){
  box.innerHTML='<div class="muted" style="padding:12px 14px">Koi match nahi mila</div>';
 }else{
  box.innerHTML=list.map((c,i)=>{const t=totals(c);const st=statusOf(c);
   return `<div class="gs-row" data-i="${i}" onclick="globalSearchGo('${c.id}')"
     style="padding:9px 14px;cursor:pointer;border-bottom:1px solid #f1f5f9;display:flex;justify-content:space-between;align-items:center;gap:10px">
    <div>
     <div style="font-weight:700">${esc(c.name)}</div>
     <div class="muted">${esc(c.mobile||'')}${c.model?' • '+esc(c.model):''}${c.frameNo?' • '+esc(c.frameNo):''}</div>
    </div>
    <div style="text-align:right;white-space:nowrap">
     <span class="badge ${st[0]}">${st[1]}</span>
     <div class="muted" style="margin-top:2px">${rupee(t.bal)} bal</div>
    </div>
   </div>`}).join('');
  _gsList=list;
 }
 box.style.display='block';
}
let _gsList=[];
function globalSearchGo(id){
 $('#globalSearch').value='';
 $('#globalSearchResults').style.display='none';
 $('#globalSearchResults').innerHTML='';
 go('detail',id);
}
function globalSearchKey(e){
 const box=$('#globalSearchResults');
 if(box.style.display==='none')return;
 const rows=box.querySelectorAll('.gs-row');
 if(e.key==='ArrowDown'){e.preventDefault();_gsIndex=Math.min(_gsIndex+1,rows.length-1);globalSearchHighlight(rows)}
 else if(e.key==='ArrowUp'){e.preventDefault();_gsIndex=Math.max(_gsIndex-1,0);globalSearchHighlight(rows)}
 else if(e.key==='Enter'){e.preventDefault();
  const pick=_gsIndex>=0&&_gsList[_gsIndex]?_gsList[_gsIndex]:_gsList[0];
  if(pick)globalSearchGo(pick.id);
 }else if(e.key==='Escape'){$('#globalSearch').value='';box.style.display='none';box.innerHTML=''}
}
function globalSearchHighlight(rows){
 rows.forEach((r,i)=>r.style.background=i===_gsIndex?'#eef2ff':'');
 if(rows[_gsIndex])rows[_gsIndex].scrollIntoView({block:'nearest'});
}
document.addEventListener('click',e=>{
 const wrap=$('#globalSearchResults');
 if(!wrap)return;
 if(e.target.id!=='globalSearch'&&!wrap.contains(e.target)){wrap.style.display='none'}
});

/* ================= ROUTER ================= */
let route={view:'dashboard',id:null};
function go(view,id){route={view:view,id:id||null};render();window.scrollTo(0,0)}
function render(){
 document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('active',t.dataset.v===(route.view==='edit'?'new':route.view==='detail'?'customers':route.view)));
 const v=$('#view');
 if(route.view==='dashboard')renderDashboard(v);
 else if(route.view==='customers')renderCustomers(v);
 else if(route.view==='new')renderForm(v,null);
 else if(route.view==='edit')renderForm(v,route.id);
