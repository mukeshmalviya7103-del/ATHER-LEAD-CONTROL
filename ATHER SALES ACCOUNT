 let ct=0;
 state.customers.forEach(c=>(c.payments||[]).forEach(p=>{if(ymKey(p.date)===ym){ct+=num(p.amount);rows.push([dstr(p.date),c.name,c.mobile,c.invoiceNo,p.mode,p.ref,num(p.amount),p.note])}}));
