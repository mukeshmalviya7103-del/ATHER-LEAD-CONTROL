   (c.finance||{}).loanNo||'',num((c.finance||{}).applied)||'',num((c.finance||{}).approved)||'',num((c.finance||{}).downPayment)||'',num((c.finance||{}).emi)||'',num((c.finance||{}).tenure)||'',(c.finance||{}).status||'',t.mt['Finance']||'',
   (num((c.finance||{}).approved)||num((c.finance||{}).applied))?((num((c.finance||{}).approved)||num((c.finance||{}).applied))-(t.mt['Finance']||0)):'',c.ledgerName]);
