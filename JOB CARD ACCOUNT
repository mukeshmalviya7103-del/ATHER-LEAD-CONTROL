<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Job Card Account & Payment Management System</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <!-- Google Fonts: Inter -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    .fade-in { animation: fadeIn 0.2s ease-in-out; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
    @media print {
      body * { visibility: visible; }
      no-print, nav, header, button { display: none !important; }
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col" data-author="Mukesh">

  <!-- Hidden Dev Signature -->
  <div style="display:none;" id="authorized-dev-meta">System Authorized & Designed for Mukesh. All rights reserved.</div>

  <!-- Top Header -->
  <header class="bg-slate-900 text-white shadow-md sticky top-0 z-30 no-print">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="bg-indigo-600 p-2 rounded-lg text-white">
          <i class="fa-solid fa-file-invoice-dollar text-xl"></i>
        </div>
        <div>
          <h1 id="brandHeaderTitle" class="font-bold text-lg leading-tight tracking-wide flex items-center gap-2">
            JobCard Ledger Pro 
            <span class="text-xs bg-indigo-500/30 text-indigo-300 border border-indigo-500/40 px-2 py-0.5 rounded-full font-medium">
              <i class="fa-solid fa-shield-halved mr-1"></i>Auth: Mukesh
            </span>
          </h1>
          <p id="brandHeaderSub" class="text-xs text-slate-400">Manual & DMS Software Job Card & Payment Account Manager</p>
        </div>
      </div>

      <!-- Global Search Bar -->
      <div class="flex-1 max-w-md mx-6 hidden lg:block">
        <div class="relative">
          <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
            <i class="fa-solid fa-search"></i>
          </span>
          <input type="text" id="globalSearchInput" placeholder="Global Search: Job Card No, Customer, Vehicle, Mobile, Advisor, Repair Type..." 
            class="w-full pl-10 pr-4 py-2 bg-slate-800 text-sm rounded-lg border border-slate-700 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition">
        </div>
      </div>

      <div class="flex items-center space-x-3">
        <button onclick="openNewJobCardModal()" class="bg-indigo-600 hover:bg-indigo-500 text-white px-4 py-2 rounded-lg text-sm font-medium shadow-sm flex items-center space-x-2 transition">
          <i class="fa-solid fa-plus-circle"></i>
          <span class="hidden sm:inline">New Job Card</span>
        </button>
        <button onclick="loadAllData()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 p-2 rounded-lg text-sm border border-slate-700 transition" title="Refresh Data">
          <i class="fa-solid fa-rotate"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- Navigation Tabs Bar -->
  <nav class="bg-white border-b border-slate-200 shadow-sm sticky top-16 z-20 no-print">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex space-x-2 overflow-x-auto">
      <button onclick="switchTab('dashboard')" id="tab-btn-dashboard" class="tab-btn px-4 py-3 text-sm font-semibold border-b-2 border-indigo-600 text-indigo-600 flex items-center gap-2 whitespace-nowrap">
        <i class="fa-solid fa-table-list"></i> Job Cards & Payments
      </button>
      <button onclick="switchTab('monthly')" id="tab-btn-monthly" class="tab-btn px-4 py-3 text-sm font-medium border-b-2 border-transparent text-slate-600 hover:text-indigo-600 flex items-center gap-2 whitespace-nowrap">
        <i class="fa-solid fa-calendar-days"></i> Monthly Report
      </button>
      <button onclick="switchTab('payments')" id="tab-btn-payments" class="tab-btn px-4 py-3 text-sm font-medium border-b-2 border-transparent text-slate-600 hover:text-indigo-600 flex items-center gap-2 whitespace-nowrap">
        <i class="fa-solid fa-money-check-dollar"></i> Payment Reports (Date-Wise)
      </button>
      <button onclick="switchTab('advisors')" id="tab-btn-advisors" class="tab-btn px-4 py-3 text-sm font-medium border-b-2 border-transparent text-slate-600 hover:text-indigo-600 flex items-center gap-2 whitespace-nowrap">
        <i class="fa-solid fa-user-tie"></i> Advisor Performance
      </button>
      <button onclick="switchTab('settings')" id="tab-btn-settings" class="tab-btn px-4 py-3 text-sm font-medium border-b-2 border-transparent text-slate-600 hover:text-indigo-600 flex items-center gap-2 whitespace-nowrap">
        <i class="fa-solid fa-gear"></i> Settings
      </button>
      <button onclick="switchTab('tools')" id="tab-btn-tools" class="tab-btn px-4 py-3 text-sm font-medium border-b-2 border-transparent text-slate-600 hover:text-indigo-600 flex items-center gap-2 whitespace-nowrap">
        <i class="fa-solid fa-toolbox"></i> Tools & Maintenance
      </button>
    </div>
  </nav>

  <!-- Mobile Search Bar -->
  <div class="bg-slate-900 px-4 py-2 lg:hidden border-t border-slate-800 no-print">
    <div class="relative">
      <span class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
        <i class="fa-solid fa-search"></i>
      </span>
      <input type="text" id="globalSearchInputMobile" placeholder="Global Search Job Cards..." 
        class="w-full pl-10 pr-4 py-2 bg-slate-800 text-sm rounded-lg border border-slate-700 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
  </div>

  <!-- Main Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- ==================== TAB 1: DASHBOARD / JOB CARDS ==================== -->
    <div id="tab-content-dashboard" class="tab-content space-y-6">
      <!-- Stats Summary Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Job Cards</p>
            <h3 id="statTotalCards" class="text-2xl font-bold text-slate-900 mt-1">0</h3>
            <p class="text-xs text-slate-500 mt-1"><span id="statManualCount">0</span> Manual | <span id="statDmsCount">0</span> DMS</p>
          </div>
          <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center text-xl">
            <i class="fa-solid fa-clipboard-list"></i>
          </div>
        </div>

        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Billed Amount</p>
            <h3 id="statTotalBilled" class="text-2xl font-bold text-slate-900 mt-1">₹0</h3>
            <p class="text-xs text-slate-400 mt-1">Net Invoice Value</p>
          </div>
          <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-xl flex items-center justify-center text-xl">
            <i class="fa-solid fa-indian-rupee-sign"></i>
          </div>
        </div>

        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Received</p>
            <h3 id="statTotalCollected" class="text-2xl font-bold text-emerald-600 mt-1">₹0</h3>
            <p class="text-xs text-slate-400 mt-1">Date-wise payments</p>
          </div>
          <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-xl">
            <i class="fa-solid fa-circle-check"></i>
          </div>
        </div>

        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Pending Balance</p>
            <h3 id="statTotalPending" class="text-2xl font-bold text-rose-600 mt-1">₹0</h3>
            <p class="text-xs text-slate-400 mt-1">Outstanding dues</p>
          </div>
          <div class="w-12 h-12 bg-rose-50 text-rose-600 rounded-xl flex items-center justify-center text-xl">
            <i class="fa-solid fa-clock-rotate-left"></i>
          </div>
        </div>

        <div class="bg-white p-5 rounded-xl shadow-sm border border-slate-200 flex items-center justify-between sm:col-span-2 lg:col-span-1">
          <div>
            <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Authorization</p>
            <h3 class="text-lg font-bold text-slate-900 mt-1 flex items-center gap-1.5">
              <i class="fa-solid fa-user-shield text-indigo-600"></i> Mukesh
            </h3>
            <p class="text-xs text-emerald-600 font-medium mt-1">● System Active</p>
          </div>
          <div class="w-12 h-12 bg-purple-50 text-purple-600 rounded-xl flex items-center justify-center text-xl">
            <i class="fa-solid fa-fingerprint"></i>
          </div>
        </div>
      </div>

      <!-- Filters & Controls Bar -->
      <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex flex-wrap gap-4 items-center justify-between">
        <div class="flex flex-wrap items-center gap-3 w-full lg:w-auto">
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Job Card No. Type</label>
            <select id="filterCardType" onchange="applyFilters()" class="bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
              <option value="All">All Job Cards</option>
              <option value="Manual">Has Manual No.</option>
              <option value="DMS Software">Has DMS No.</option>
              <option value="Both">Both Manual + DMS No.</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Repair Type</label>
            <select id="filterRepairType" onchange="applyFilters()" class="bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
              <option value="All">All Repair Types</option>
              <option value="Periodic Service">Periodic Service</option>
              <option value="Mechanical Repair">Mechanical Repair</option>
              <option value="Denting & Painting">Denting & Painting</option>
              <option value="Electrical & AC">Electrical & AC</option>
              <option value="Accidental Repair">Accidental Repair</option>
              <option value="General Checkup">General Checkup</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Payment Status</label>
            <select id="filterStatus" onchange="applyFilters()" class="bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
              <option value="All">All Status</option>
              <option value="Paid">Paid</option>
              <option value="Partial">Partial</option>
              <option value="Unpaid">Unpaid</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">From Date</label>
            <input type="date" id="filterFromDate" onchange="applyFilters()" class="bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg px-3 py-1.5 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
          </div>

          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">To Date</label>
            <input type="date" id="filterToDate" onchange="applyFilters()" class="bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg px-3 py-1.5 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
          </div>

          <div class="self-end">
            <button onclick="resetFilters()" class="bg-slate-200 hover:bg-slate-300 text-slate-700 px-3 py-2 rounded-lg text-sm font-medium transition">
              <i class="fa-solid fa-rotate-right mr-1"></i> Reset
            </button>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button onclick="exportDataJSON()" class="bg-slate-800 hover:bg-slate-700 text-white px-3 py-2 rounded-lg text-sm font-medium flex items-center gap-2 transition">
            <i class="fa-solid fa-download"></i> Backup JSON
          </button>
          <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-500 text-white px-3 py-2 rounded-lg text-sm font-medium flex items-center gap-2 transition">
            <i class="fa-solid fa-print"></i> Print
          </button>
        </div>
      </div>

      <!-- Job Cards Table Section -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <div class="p-4 border-b border-slate-200 flex justify-between items-center bg-slate-50/50">
          <h2 class="font-bold text-slate-800 text-base flex items-center gap-2">
            <i class="fa-solid fa-table-list text-indigo-600"></i> Job Card Accounts & Payment Records
          </h2>
          <span id="recordCountBadge" class="text-xs bg-indigo-100 text-indigo-800 font-semibold px-2.5 py-1 rounded-full">0 Records</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-slate-100/70 text-slate-600 uppercase text-xs tracking-wider border-b border-slate-200">
                <th class="py-3 px-4 font-semibold">Job Card No / Type</th>
                <th class="py-3 px-4 font-semibold">Repair Type</th>
                <th class="py-3 px-4 font-semibold">Date</th>
                <th class="py-3 px-4 font-semibold">Customer & Vehicle</th>
                <th class="py-3 px-4 font-semibold">Advisor</th>
                <th class="py-3 px-4 font-semibold text-right">Net Amount</th>
                <th class="py-3 px-4 font-semibold text-right">Paid</th>
                <th class="py-3 px-4 font-semibold text-right">Balance</th>
                <th class="py-3 px-4 font-semibold text-center">Status</th>
                <th class="py-3 px-4 font-semibold text-center">Actions (One-Click)</th>
              </tr>
            </thead>
            <tbody id="jobCardTableBody" class="divide-y divide-slate-200 text-slate-700">
              <!-- Dynamically populated rows -->
            </tbody>
          </table>
        </div>

        <!-- Empty State -->
        <div id="emptyState" class="hidden py-16 text-center">
          <div class="text-slate-300 text-5xl mb-3"><i class="fa-solid fa-folder-open"></i></div>
          <p class="text-slate-600 font-medium">No job cards found matching your filters or search.</p>
          <p class="text-slate-400 text-xs mt-1">Try clearing search filters or create a new job card.</p>
        </div>
      </div>
    </div>

    <!-- ==================== TAB 2: MONTHLY REPORT ==================== -->
    <div id="tab-content-monthly" class="tab-content space-y-6 hidden">
      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-200">
          <div>
            <h2 class="font-bold text-slate-800 text-lg flex items-center gap-2">
              <i class="fa-solid fa-calendar-days text-indigo-600"></i> Monthly Financial Reports & Summary
            </h2>
            <p class="text-xs text-slate-500 mt-1">Month-wise breakdown of billing, collections, and job card counts</p>
          </div>
          <div class="flex items-center gap-2">
            <button onclick="exportMonthlyCSV()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-2 rounded-lg text-sm font-medium transition flex items-center gap-1.5">
              <i class="fa-solid fa-file-excel"></i> Export CSV
            </button>
            <button onclick="loadMonthlyReport()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-2 rounded-lg text-sm font-medium transition">
              <i class="fa-solid fa-rotate mr-1"></i> Refresh
            </button>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-slate-100 text-slate-600 uppercase text-xs tracking-wider border-b border-slate-200">
                <th class="py-3 px-4 font-semibold">Month (YYYY-MM)</th>
                <th class="py-3 px-4 font-semibold text-center">Total Job Cards</th>
                <th class="py-3 px-4 font-semibold text-center">Manual / DMS</th>
                <th class="py-3 px-4 font-semibold text-right">Total Billed (₹)</th>
                <th class="py-3 px-4 font-semibold text-right">Total Collected (₹)</th>
                <th class="py-3 px-4 font-semibold text-right">Pending Balance (₹)</th>
              </tr>
            </thead>
            <tbody id="monthlyReportTableBody" class="divide-y divide-slate-200 text-slate-700">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ==================== TAB: PAYMENT REPORTS (Date-Wise & Month-Wise) ==================== -->
    <div id="tab-content-payments" class="tab-content space-y-6 hidden">

      <!-- Mode-wise Totals -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
          <p class="text-[11px] font-semibold text-slate-500 uppercase">UPI</p>
          <p id="payTotalUPI" class="text-lg font-bold text-slate-900 mt-1">₹0</p>
        </div>
        <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
          <p class="text-[11px] font-semibold text-slate-500 uppercase">Cash</p>
          <p id="payTotalCash" class="text-lg font-bold text-slate-900 mt-1">₹0</p>
        </div>
        <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
          <p class="text-[11px] font-semibold text-slate-500 uppercase">Bank / NEFT</p>
          <p id="payTotalBank" class="text-lg font-bold text-slate-900 mt-1">₹0</p>
        </div>
        <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
          <p class="text-[11px] font-semibold text-slate-500 uppercase">Cheque</p>
          <p id="payTotalCheque" class="text-lg font-bold text-slate-900 mt-1">₹0</p>
        </div>
        <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200">
          <p class="text-[11px] font-semibold text-slate-500 uppercase">Credit Card</p>
          <p id="payTotalCard" class="text-lg font-bold text-slate-900 mt-1">₹0</p>
        </div>
        <div class="bg-indigo-600 p-4 rounded-xl shadow-sm border border-indigo-600">
          <p class="text-[11px] font-semibold text-indigo-200 uppercase">Grand Total Received</p>
          <p id="payTotalGrand" class="text-lg font-bold text-white mt-1">₹0</p>
        </div>
      </div>

      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b border-slate-200">
          <div>
            <h2 class="font-bold text-slate-800 text-lg flex items-center gap-2">
              <i class="fa-solid fa-money-check-dollar text-indigo-600"></i> Date-Wise & Month-Wise Payment Report
            </h2>
            <p class="text-xs text-slate-500 mt-1">Har payment kis date par aur kis mode se aayi hai — advanced monthly & date-wise filtering aur export</p>
          </div>
          <div class="flex items-center gap-2">
            <select id="payFilterMonth" onchange="loadPaymentReport()" class="bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
              <option value="All">All Months</option>
            </select>
            <select id="payFilterMode" onchange="loadPaymentReport()" class="bg-slate-50 border border-slate-300 text-slate-800 text-sm rounded-lg px-3 py-2 focus:ring-2 focus:ring-indigo-500 focus:outline-none">
              <option value="All">All Modes</option>
              <option value="UPI">UPI</option>
              <option value="Cash">Cash</option>
              <option value="Bank Transfer">Bank Transfer / NEFT</option>
              <option value="Cheque">Cheque</option>
              <option value="Credit Card">Credit Card</option>
            </select>
            <button onclick="exportPaymentsCSV()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-3 py-2 rounded-lg text-sm font-medium transition flex items-center gap-1.5">
              <i class="fa-solid fa-file-excel"></i> Export CSV
            </button>
            <button onclick="loadPaymentReport()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-2 rounded-lg text-sm font-medium transition">
              <i class="fa-solid fa-rotate"></i>
            </button>
            <button onclick="window.print()" class="bg-indigo-600 hover:bg-indigo-500 text-white px-3 py-2 rounded-lg text-sm font-medium transition">
              <i class="fa-solid fa-print"></i>
            </button>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-slate-100 text-slate-600 uppercase text-xs tracking-wider border-b border-slate-200">
                <th class="py-3 px-4 font-semibold">Payment Date</th>
                <th class="py-3 px-4 font-semibold">Job Card No.</th>
                <th class="py-3 px-4 font-semibold">Customer / Vehicle</th>
                <th class="py-3 px-4 font-semibold">Mode</th>
                <th class="py-3 px-4 font-semibold">Reference</th>
                <th class="py-3 px-4 font-semibold text-right">Amount (₹)</th>
              </tr>
            </thead>
            <tbody id="paymentReportTableBody" class="divide-y divide-slate-200 text-slate-700">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ==================== TAB 3: ADVISOR PERFORMANCE ==================== -->
    <div id="tab-content-advisors" class="tab-content space-y-6 hidden">
      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-200">
          <div>
            <h2 class="font-bold text-slate-800 text-lg flex items-center gap-2">
              <i class="fa-solid fa-user-tie text-indigo-600"></i> Service Advisor Performance & Revenue Report
            </h2>
            <p class="text-xs text-slate-500 mt-1">Track job cards handled, billed amounts, and collection efficiency per advisor</p>
          </div>
          <button onclick="loadAdvisorPerformance()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-3 py-2 rounded-lg text-sm font-medium transition">
            <i class="fa-solid fa-rotate mr-1"></i> Refresh Performance
          </button>
        </div>

