    function computeJobCard(raw) {
      const paid_amount = (raw.payments || []).reduce((sum, p) => sum + Number(p.amount || 0), 0);
      const balance_due = raw.net_amount - paid_amount;
      let status = 'Unpaid';
      if (balance_due <= 0) status = 'Paid';
      else if (paid_amount > 0) status = 'Partial';
      return Object.assign({}, raw, {
        repair_type: raw.repair_type || 'Periodic Service',
        paid_amount: paid_amount,
        total_paid: paid_amount,
        balance_due: balance_due,
        status: status
      });
    }

    function getComputedJobCards() {
      const db = getDB();
      return db.jobcards.map(computeJobCard).sort((a, b) => (b.entry_date || '').localeCompare(a.entry_date || '') || b.id - a.id);
    }

    function computeStats(cards) {
      const total_billed = cards.reduce((s, c) => s + c.net_amount, 0);
      const total_collected = cards.reduce((s, c) => s + c.paid_amount, 0);
      return {
        total_job_cards: cards.length,
        total_billed: total_billed,
        total_collected: total_collected,
        total_pending: total_billed - total_collected,
        manual_count: cards.filter(c => c.manual_job_card_no && c.manual_job_card_no.trim()).length,
        dms_count: cards.filter(c => c.dms_job_card_no && c.dms_job_card_no.trim()).length
      };
    }

    function getAllPaymentsFlat() {
      const cards = getComputedJobCards();
      const rows = [];
      cards.forEach(c => {
        (c.payments || []).forEach(p => {
          rows.push({
            payment_date: p.payment_date,
            amount: Number(p.amount || 0),
            payment_mode: p.payment_mode,
            reference_no: p.reference_no,
            job_card_label: [c.manual_job_card_no, c.dms_job_card_no].filter(Boolean).join(' / ') || '-',
            customer_name: c.customer_name,
            vehicle_no: c.vehicle_no
          });
        });
      });
      rows.sort((a, b) => (b.payment_date || '').localeCompare(a.payment_date || ''));
      return rows;
    }

