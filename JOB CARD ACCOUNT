    function filterAndRenderTable(searchQuery = '') {
      const cardType = document.getElementById('filterCardType').value;
      const repairTypeFilter = document.getElementById('filterRepairType').value;
      const status = document.getElementById('filterStatus').value;
      const fromDate = document.getElementById('filterFromDate').value;
      const toDate = document.getElementById('filterToDate').value;

      const filtered = allJobCards.filter(jc => {
        const hasManual = !!(jc.manual_job_card_no && jc.manual_job_card_no.trim());
        const hasDms = !!(jc.dms_job_card_no && jc.dms_job_card_no.trim());

        if (searchQuery) {
          const q = searchQuery.toLowerCase();
          const match = (jc.manual_job_card_no || '').toLowerCase().includes(q) ||
                        (jc.dms_job_card_no || '').toLowerCase().includes(q) ||
                        (jc.repair_type || '').toLowerCase().includes(q) ||
                        jc.customer_name.toLowerCase().includes(q) ||
                        jc.mobile.toLowerCase().includes(q) ||
                        jc.vehicle_no.toLowerCase().includes(q) ||
                        (jc.vehicle_model && jc.vehicle_model.toLowerCase().includes(q)) ||
                        (jc.advisor_name && jc.advisor_name.toLowerCase().includes(q));
          if (!match) return false;
        }

        if (cardType === 'Manual' && !hasManual) return false;
        if (cardType === 'DMS Software' && !hasDms) return false;
        if (cardType === 'Both' && !(hasManual && hasDms)) return false;
        if (repairTypeFilter !== 'All' && jc.repair_type !== repairTypeFilter) return false;
        if (status !== 'All' && jc.status !== status) return false;
        if (fromDate && jc.entry_date < fromDate) return false;
        if (toDate && jc.entry_date > toDate) return false;

        return true;
      });

      renderTable(filtered);
    }

