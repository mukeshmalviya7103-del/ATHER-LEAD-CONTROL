      }
      emptyState.classList.add('hidden');

      data.forEach(jc => {
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50/80 transition cursor-pointer';
        tr.onclick = (e) => {
          if (e.target.closest('button')) return;
          openDetailModal(jc.id);
        };

        const paid = jc.paid_amount || 0;
        const balance = jc.net_amount - paid;

        let statusClass = 'bg-rose-100 text-rose-800 border border-rose-200';
        if (jc.status === 'Paid') statusClass = 'bg-emerald-100 text-emerald-800 border border-emerald-200';
        else if (jc.status === 'Partial') statusClass = 'bg-amber-100 text-amber-800 border border-amber-200';

        let typeBadge = '';
        if (jc.manual_job_card_no && jc.manual_job_card_no.trim()) {
