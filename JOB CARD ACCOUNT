        }
        if (jc.dms_job_card_no && jc.dms_job_card_no.trim()) {
          typeBadge += `<div class="text-xs bg-blue-50 text-blue-700 px-2 py-0.5 rounded border border-blue-200 font-medium inline-block mb-1">DMS: ${jc.dms_job_card_no}</div>`;
        }
        if (!typeBadge) typeBadge = '<span class="text-xs text-slate-400">No number set</span>';

        tr.innerHTML = `
          <td class="py-3 px-4">
            <div>${typeBadge}</div>
          </td>
          <td class="py-3 px-4 text-xs font-semibold text-indigo-700">
            <span class="bg-indigo-50 px-2.5 py-1 rounded-full border border-indigo-100">${jc.repair_type || 'Periodic Service'}</span>
          </td>
          <td class="py-3 px-4 text-xs font-medium text-slate-600">${jc.entry_date}</td>
          <td class="py-3 px-4">
            <div class="font-semibold text-slate-900">${jc.customer_name}</div>
            <div class="text-xs text-slate-500">${jc.mobile} | <span class="font-medium text-slate-700">${jc.vehicle_no}</span> ${jc.vehicle_model ? '(' + jc.vehicle_model + ')' : ''}</div>
          </td>
          <td class="py-3 px-4 text-xs text-slate-600">${jc.advisor_name || '-'}</td>
          <td class="py-3 px-4 text-right font-semibold text-slate-900">₹${jc.net_amount.toLocaleString('en-IN')}</td>
          <td class="py-3 px-4 text-right font-medium text-emerald-600">₹${paid.toLocaleString('en-IN')}</td>
          <td class="py-3 px-4 text-right font-medium text-rose-600">₹${balance > 0 ? balance.toLocaleString('en-IN') : '0'}</td>
          <td class="py-3 px-4 text-center">
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold ${statusClass}">${jc.status}</span>
          </td>
          <td class="py-3 px-4 text-center">
            <div class="flex items-center justify-center space-x-1.5">
              <button onclick="openDetailModal(${jc.id})" title="View Full Info & Payments" class="bg-indigo-50 hover:bg-indigo-100 text-indigo-600 p-2 rounded-lg transition">
                <i class="fa-solid fa-eye text-xs"></i>
              </button>
              <button onclick="editJobCard(${jc.id})" title="Edit Job Card" class="bg-slate-100 hover:bg-slate-200 text-slate-700 p-2 rounded-lg transition">
                <i class="fa-solid fa-pen text-xs"></i>
              </button>
              <button onclick="deleteJobCard(${jc.id})" title="Delete Job Card" class="bg-rose-50 hover:bg-rose-100 text-rose-600 p-2 rounded-lg transition">
                <i class="fa-solid fa-trash text-xs"></i>
              </button>
            </div>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function openNewJobCardModal() {
      document.getElementById('jobCardForm').reset();
      document.getElementById('editJobCardId').value = '';
      document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-file-circle-plus text-indigo-400"></i> New Job Card Payment Entry';
      document.getElementById('entry_date').valueAsDate = new Date();
      calculateNet();
      document.getElementById('jobCardModal').classList.remove('hidden');
    }

    function closeJobCardModal() {
      document.getElementById('jobCardModal').classList.add('hidden');
    }

    function calculateNet() {
      const total = parseFloat(document.getElementById('total_amount').value) || 0;
      const discount = parseFloat(document.getElementById('discount').value) || 0;
      const net = total - discount;
      document.getElementById('previewNet').innerText = '₹' + net.toLocaleString('en-IN', {minimumFractionDigits: 2});
    }

    function saveJobCard(e) {
      e.preventDefault();
      const id = document.getElementById('editJobCardId').value;
      const manual_no = document.getElementById('manual_job_card_no').value.trim();
      const dms_no = document.getElementById('dms_job_card_no').value.trim();
      const repair_type = document.getElementById('repair_type').value;
      const total_amount = parseFloat(document.getElementById('total_amount').value) || 0;
      const discount = parseFloat(document.getElementById('discount').value) || 0;

      if (!manual_no && !dms_no) {
        alert('Kam se kam ek Job Card No. bharo — Manual ya DMS.');
        return;
      }

      if (!document.getElementById('customer_name').value.trim() ||
          !document.getElementById('mobile').value.trim() ||
          !document.getElementById('vehicle_no').value.trim() ||
          !document.getElementById('entry_date').value) {
        alert('Please fill all required (*) fields.');
        return;
      }

      const db = getDB();

      const fields = {
        manual_job_card_no: manual_no,
        dms_job_card_no: dms_no,
        repair_type: repair_type,
        entry_date: document.getElementById('entry_date').value,
        customer_name: document.getElementById('customer_name').value.trim(),
        mobile: document.getElementById('mobile').value.trim(),
        vehicle_no: document.getElementById('vehicle_no').value.trim().toUpperCase(),
        vehicle_model: document.getElementById('vehicle_model').value.trim(),
        advisor_name: document.getElementById('advisor_name').value.trim(),
        total_amount: total_amount,
        discount: discount,
        net_amount: total_amount - discount,
        remarks: document.getElementById('remarks').value.trim()
      };

      if (id) {
        const idx = db.jobcards.findIndex(j => String(j.id) === String(id));
        if (idx === -1) { alert('Job card not found.'); return; }
        db.jobcards[idx] = Object.assign({}, db.jobcards[idx], fields);
      } else {
        const newCard = Object.assign({
          id: db.next_id++,
          payments: [],
          created_at: new Date().toISOString()
        }, fields);
        db.jobcards.push(newCard);
      }

      saveDB(db);
      closeJobCardModal();
      loadAllData();
    }

    function editJobCard(id) {
      const db = getDB();
      const jc = db.jobcards.find(j => String(j.id) === String(id));
      if (!jc) { alert('Job card not found.'); return; }

      document.getElementById('editJobCardId').value = jc.id;
      document.getElementById('manual_job_card_no').value = jc.manual_job_card_no || '';
      document.getElementById('dms_job_card_no').value = jc.dms_job_card_no || '';
      document.getElementById('repair_type').value = jc.repair_type || 'Periodic Service';
      document.getElementById('entry_date').value = jc.entry_date;
      document.getElementById('customer_name').value = jc.customer_name;
      document.getElementById('mobile').value = jc.mobile;
      document.getElementById('vehicle_no').value = jc.vehicle_no;
      document.getElementById('vehicle_model').value = jc.vehicle_model || '';
      document.getElementById('advisor_name').value = jc.advisor_name || '';
      document.getElementById('total_amount').value = jc.total_amount;
      document.getElementById('discount').value = jc.discount || 0;
      document.getElementById('remarks').value = jc.remarks || '';

      calculateNet();
      document.getElementById('modalTitle').innerHTML = '<i class="fa-solid fa-pen-to-square text-indigo-400"></i> Edit Job Card Entry';
      document.getElementById('jobCardModal').classList.remove('hidden');
    }

    function deleteJobCard(id) {
      if (!confirm('Are you sure you want to delete this Job Card and all associated payment records?')) return;
      const db = getDB();
      db.jobcards = db.jobcards.filter(j => String(j.id) !== String(id));
      saveDB(db);
      loadAllData();
    }

    function openDetailModal(id) {
      currentSelectedJobCardId = id;
      {
        const db = getDB();
        const raw = db.jobcards.find(j => String(j.id) === String(id));
        if (!raw) { alert('Job card not found.'); return; }
        const jc = computeJobCard(raw);

        document.getElementById('detJobCardNo').innerText = jc.manual_job_card_no || jc.dms_job_card_no || 'No Number';
        document.getElementById('detCardType').innerText = `Manual: ${jc.manual_job_card_no || '-'}  |  DMS: ${jc.dms_job_card_no || '-'}`;
        document.getElementById('detCustomerName').innerText = jc.customer_name;
        document.getElementById('detMobile').innerText = jc.mobile;
        document.getElementById('detVehicleNo').innerText = jc.vehicle_no;
        document.getElementById('detVehicleModel').innerText = jc.vehicle_model || 'No model specified';
        document.getElementById('detNetAmt').innerText = '₹' + jc.net_amount.toLocaleString('en-IN');
        document.getElementById('detPaidAmt').innerText = '₹' + jc.total_paid.toLocaleString('en-IN');
        document.getElementById('detBalanceAmt').innerText = '₹' + jc.balance_due.toLocaleString('en-IN');
        document.getElementById('detRepairType').innerText = jc.repair_type || 'Periodic Service';
        document.getElementById('detEntryDate').innerText = jc.entry_date;
        document.getElementById('detAdvisor').innerText = jc.advisor_name || 'N/A';
        document.getElementById('detRemarks').innerText = jc.remarks || 'No remarks added.';
        document.getElementById('payJobCardId').value = jc.id;

        const badge = document.getElementById('detStatusBadge');
        badge.innerText = jc.status;
        if (jc.status === 'Paid') {
          badge.className = 'inline-block mt-1 text-xs px-2.5 py-0.5 rounded font-medium bg-emerald-100 text-emerald-800 border border-emerald-200';
        } else if (jc.status === 'Partial') {
          badge.className = 'inline-block mt-1 text-xs px-2.5 py-0.5 rounded font-medium bg-amber-100 text-amber-800 border border-amber-200';
        } else {
          badge.className = 'inline-block mt-1 text-xs px-2.5 py-0.5 rounded font-medium bg-rose-100 text-rose-800 border border-rose-200';
        }

        const pTbody = document.getElementById('paymentHistoryTableBody');
        pTbody.innerHTML = '';
        if (jc.payments.length === 0) {
          pTbody.innerHTML = `<tr><td colspan="6" class="py-4 text-center text-slate-400">No payment records found for this job card. Click "Add Payment" above.</td></tr>`;
        } else {
          jc.payments.forEach(p => {
            const tr = document.createElement('tr');
            tr.className = 'hover:bg-slate-50';
            tr.innerHTML = `
              <td class="py-2.5 px-3 font-medium text-slate-800">${p.payment_date}</td>
              <td class="py-2.5 px-3"><span class="bg-slate-100 px-2 py-0.5 rounded text-slate-700 font-medium">${p.payment_mode}</span></td>
              <td class="py-2.5 px-3 text-slate-600">${p.reference_no || '-'}</td>
              <td class="py-2.5 px-3 text-slate-600">${p.notes || '-'}</td>
              <td class="py-2.5 px-3 text-right font-bold text-emerald-600">₹${p.amount.toLocaleString('en-IN')}</td>
              <td class="py-2.5 px-3 text-center">
                <button onclick="deletePayment(${p.id})" class="text-rose-500 hover:text-rose-700 p-1" title="Delete Payment">
                  <i class="fa-solid fa-trash-can text-xs"></i>
                </button>
              </td>
            `;
            pTbody.appendChild(tr);
          });
        }

        document.getElementById('paymentFormContainer').classList.add('hidden');
        document.getElementById('detailModal').classList.remove('hidden');
      }
    }

    function closeDetailModal() {
      document.getElementById('detailModal').classList.add('hidden');
      loadAllData();
    }

    function togglePaymentForm() {
      const container = document.getElementById('paymentFormContainer');
      container.classList.toggle('hidden');
      document.getElementById('pay_date').valueAsDate = new Date();
    }

    function submitPayment(e) {
      e.preventDefault();
      const jobCardId = document.getElementById('payJobCardId').value;
      const amount = parseFloat(document.getElementById('pay_amount').value) || 0;
      if (amount <= 0) { alert('Please enter a valid payment amount.'); return; }

      const db = getDB();
      const idx = db.jobcards.findIndex(j => String(j.id) === String(jobCardId));
      if (idx === -1) { alert('Job card not found.'); return; }

      const payment = {
        id: db.next_payment_id++,
        payment_date: document.getElementById('pay_date').value,
        amount: amount,
        payment_mode: document.getElementById('pay_mode').value,
        reference_no: document.getElementById('pay_ref').value.trim(),
        notes: 'Payment recorded via portal'
      };
      if (!db.jobcards[idx].payments) db.jobcards[idx].payments = [];
      db.jobcards[idx].payments.push(payment);
      saveDB(db);

      document.getElementById('paymentEntryForm').reset();
      document.getElementById('paymentFormContainer').classList.add('hidden');
      openDetailModal(jobCardId);
    }

    function deletePayment(paymentId) {
      if (!confirm('Are you sure you want to delete this payment entry?')) return;
      const db = getDB();
      const idx = db.jobcards.findIndex(j => String(j.id) === String(currentSelectedJobCardId));
      if (idx === -1) { alert('Job card not found.'); return; }
      db.jobcards[idx].payments = (db.jobcards[idx].payments || []).filter(p => String(p.id) !== String(paymentId));
      saveDB(db);
      openDetailModal(currentSelectedJobCardId);
    }

    function exportDataJSON() {
      const db = getDB();
      const blob = new Blob([JSON.stringify(db, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `jobcards_backup_${new Date().toISOString().split('T')[0]}.json`;
      a.click();
      URL.revokeObjectURL(url);
    }

    function importDataJSON(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(event) {
        try {
          const json = JSON.parse(event.target.result);
          if (!json || !Array.isArray(json.jobcards)) {
            alert('Invalid backup file format!');
            return;
          }
          if (!confirm('Restoring from backup will replace current data. Are you sure?')) return;

          if (!json.settings) json.settings = { workshop_name: 'Mukesh Auto Workshop & Service Center', authorized_by: 'Mukesh', workshop_address: '', workshop_phone: '', tax_rate: '18', currency: '₹' };
          if (!json.next_id) json.next_id = Math.max(1, ...json.jobcards.map(j => (j.id || 0) + 1));
          if (!json.next_payment_id) {
            const allPayIds = json.jobcards.flatMap(j => (j.payments || []).map(p => p.id || 0));
            json.next_payment_id = Math.max(1, ...allPayIds.map(x => x + 1));
          }

          saveDB(json);
          alert('Database restored successfully!');
          loadSettings();
          loadAllData();
        } catch (err) {
          alert('Invalid JSON file format!');
          console.error(err);
        }
        e.target.value = '';
      };
      reader.readAsText(file);
    }

    function resetAllData() {
      if (!confirm('DANGER ZONE: Are you sure you want to delete ALL job cards and payment entries? This action cannot be undone!')) return;
      if (!confirm('Please confirm again that you want to wipe all records.')) return;

      localStorage.removeItem(DB_KEY);
      getDB();
      alert('All records cleared successfully.');
      loadAllData();
    }
  </script>
